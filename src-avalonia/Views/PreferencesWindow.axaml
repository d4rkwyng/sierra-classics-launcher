<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SierraLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="600"
        x:Class="SierraLauncher.Views.PreferencesWindow"
        x:DataType="vm:PreferencesWindowViewModel"
        Title="Preferences"
        Width="550" Height="600"
        WindowStartupLocation="CenterOwner">

    <TabControl Margin="10">
        <!-- General Settings Tab -->
        <TabItem Header="General">
            <ScrollViewer>
                <StackPanel Spacing="15" Margin="10">
                    <TextBlock Text="Paths" FontWeight="Bold" FontSize="14" />

                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="DOSBox Path:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DosBoxPath}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ScummVM Path:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScummVMPath}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="XML Database:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding XmlDatabasePath}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Game Art Path:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GameArtPath}" />
                    </Grid>

                    <Separator Margin="0,10" />

                    <TextBlock Text="Window Settings" FontWeight="Bold" FontSize="14" />

                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Title Format:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TitleWindowFormat}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Startup DB:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding StartupOptions}"
                                  SelectedItem="{Binding SelectedStartupOption}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Custom DB:"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsCustomStartupVisible}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding CustomStartupDatabase}"
                                 IsVisible="{Binding IsCustomStartupVisible}" />
                    </Grid>

                    <Separator Margin="0,10" />

                    <TextBlock Text="Options" FontWeight="Bold" FontSize="14" />

                    <StackPanel Spacing="8">
                        <CheckBox Content="Close preferences window after saving"
                                  IsChecked="{Binding CloseOnSave}" />
                        <CheckBox Content="Hide database selector on main window"
                                  IsChecked="{Binding HideDatabase}" />
                        <CheckBox Content="Remember last database on exit"
                                  IsChecked="{Binding RememberLastDatabase}" />
                        <CheckBox Content="Show game artwork on mouse hover"
                                  IsChecked="{Binding ShowGameArtOnHover}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Database Editor Tab -->
        <TabItem Header="Database Editor">
            <DockPanel Margin="10">
                <!-- Database Selector -->
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,15">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Delete"
                                Command="{Binding DeleteDatabaseCommand}"
                                Margin="5,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="New"
                                Command="{Binding NewDatabaseCommand}"
                                Margin="5,0,0,0" />
                        <ComboBox ItemsSource="{Binding AvailableDatabases}"
                                  SelectedItem="{Binding SelectedDatabase}"
                                  HorizontalAlignment="Stretch" />
                    </DockPanel>
                </StackPanel>

                <!-- Database Info -->
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DatabaseName}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="# of Games:" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding NumberOfGames}"
                                   Minimum="1" Maximum="7" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Default Path:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DefaultPath}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Manual:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ManualPath}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Artwork:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CollectionArtPath}" />
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- Game Editor Tab -->
        <TabItem Header="Game Editor">
            <DockPanel Margin="10">
                <!-- Navigation -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <Button DockPanel.Dock="Left" Content="Previous"
                            Command="{Binding PreviousGameCommand}" />
                    <Button DockPanel.Dock="Right" Content="Next"
                            Command="{Binding NextGameCommand}" />
                    <TextBlock Text="{Binding CurrentGameIndex, StringFormat='Game {0}'}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                </DockPanel>

                <!-- Game Fields -->
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8"
                      DataContext="{Binding CurrentGame}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Program:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Program}">
                        <ComboBoxItem Content="" />
                        <ComboBoxItem Content="dosbox" />
                        <ComboBoxItem Content="scummvm" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Path:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Path}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Executable:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Executable}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Arguments:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CommandLine}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Artwork:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ArtworkPath}" />
                </Grid>
            </DockPanel>
        </TabItem>
    </TabControl>

    <!-- Bottom Buttons -->
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="#f5f5f5" />
        </Style>
    </Window.Styles>

</Window>
